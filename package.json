{
  "name": "chartjs-plugin-zoom",
  "homepage": "https://www.chartjs.org/chartjs-plugin-zoom/",
  "description": "Plugin that enables zoom and pan functionality in Chart.js charts.",
  "version": "0.0.0-development",
  "license": "MIT",
  "type": "module",
  "jsdelivr": "dist/chartjs-plugin-zoom.min.js",
  "unpkg": "dist/chartjs-plugin-zoom.min.js",
  "main": "dist/chartjs-plugin-zoom.cjs",
  "module": "dist/chartjs-plugin-zoom.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/chartjs-plugin-zoom.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/chartjs-plugin-zoom.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chartjs/chartjs-plugin-zoom.git"
  },
  "scripts": {
    "autobuild": "rollup -c -w",
    "emitDeclarations": "tsc -p tsconfig.build.json --emitDeclarationOnly && rollup -c rollup.dts.config.js",
    "build": "rollup -c && npm run emitDeclarations",
    "prepack": "npm run build",
    "predev": "playwright install chromium firefox",
    "dev": "vitest --config vitest.browser.config.ts",
    "predev:ff": "playwright install firefox",
    "dev:ff": "vitest --config vitest.browser.config.ts --browser=firefox",
    "docs": "npm run build && npm run docs:api && vitepress build docs",
    "docs:dev": "npm run docs:api && concurrently \"npm run autobuild\" \"vitepress dev docs\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.js\" \"docs/**/*.{js,ts,vue}\" \"**/*.md\" \"samples/**/*.html\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "test": "npm run test-types && npm run test-unit && npm run test-browser && npm run test-integration",
    "test-unit": "vitest run --config vitest.config.ts --coverage",
    "pretest-browser": "playwright install chromium firefox",
    "test-browser": "vitest run --config vitest.browser.config.ts --coverage",
    "pretest-integration": "playwright install chromium firefox",
    "test-integration": "node test/integration/require.cjs && node test/integration/import.mjs && vitest run --config vitest.integration.config.ts",
    "prefixtures:update": "playwright install chromium",
    "fixtures:update": "cross-env UPDATE_FIXTURES=1 vitest run --config vitest.browser.config.ts",
    "test-types": "tsc -p test/types/ --noEmit && tsc -p test/types/package/ --noEmit",
    "docs:api": "typedoc",
    "docs:preview": "vitepress preview docs",
    "typecheck:docs": "npm run docs:api && vue-tsc -p tsconfig.docs.json --noEmit"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "dist/*.map"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-swc": "^0.4.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@swc/core": "^1.9.3",
    "@types/node": "^24.19.2",
    "@types/prismjs": "^1.26.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-istanbul": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "acorn": "^8.14.0",
    "chart.js": "^4.4.8",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-test-utils": "^1.1.0",
    "concurrently": "^9.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cross-env": "^10.1.0",
    "date-fns": "^2.21.1",
    "eslint": "^8.57.1",
    "eslint-config-chartjs": "^0.3.0",
    "eslint-plugin-html": "^8.1.2",
    "eslint-plugin-markdown": "^2.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "playwright": "^1.65.1",
    "prismjs": "^1.30.0",
    "rollup": "^4.27.4",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-dts": "^6.5.1",
    "semantic-release": "^25.0.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "chart.js": ">=3.2.0"
  }
}
